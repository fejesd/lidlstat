# Kötelező: a lidl-stats-login paranccsal szerzett refresh token
LIDL_REFRESH_TOKEN=

LIDL_COUNTRY=HU
LIDL_LANGUAGE=hu
TIMEZONE=Europe/Budapest

# Ennyi óránként tölti le automatikusan az új blokkokat (0 = kikapcsolva)
SYNC_INTERVAL_HOURS=6

# Opcionális hozzáférési kód a webapphoz (ajánlott, ha nem csak otthoni hálózaton éred el)
APP_TOKEN=

# Ha a Lidl API elutasítja a kéréseket, emeld egy aktuális Lidl Plus app verzióra
# LIDL_APP_VERSION=16.45.5
